namespace tensor_ir.rt.schema;

// Avoid the major()/minor() device-number macros from QNX system headers in
// the generated C++ accessors.
struct BcVersion { major_version: uint8; minor_version: uint8; tag: uint16; }

enum Persistence : uint8 {
  None = 0,
  Static = 1,
}

// Mirrors tensor_ir::rt::ElementType.
enum ElementType : uint8 {
  Bool = 0,
  F16,
  BF16,
  F32,
  F64,
  F8E4M3FN,
  F8E5M2,
  SI8,
  SI16,
  SI32,
  SI64,
  UI8,
  UI16,
  UI32,
  UI64,
}

table TensorArgDesc {
  element_type: ElementType;
  // Per-dim size/stride; a runtime-determined dim is marked with
  // TensorArgDesc::kDynamic (not necessarily "static"). shape's length is
  // the rank; strides, when present, must have the same length.
  shape: [int64];
  // Absent (not just empty) means no explicit strides were provided.
  strides: [int64];
}

table ScalarArgDesc {
  element_type: ElementType;
}

union ArgDesc { TensorArgDesc, ScalarArgDesc }

struct GridDimensions { x: int32; y: int32; z: int32; }

table KernelMetadata {
  name: string (required);
  args: [ArgDesc];
  tile_sizes: [int32];
  num_inputs: int32;
  grid_shape_tensor_idx: int32;
  grid_shape: [int64];
  grid_shape_dim_mapping: [int32];
  persistence: Persistence;
  sm_count: int32;
  occupancy: int32;
  static_grid: GridDimensions;  // absent -> runtime-computed grid
  // True when the device code waits on the preceding grid (griddepcontrol), so
  // launching it with programmatic stream serialization is safe.
  uses_pdl: bool;
}

table Entrypoint {
  // Symbol exported by host_module when native host code is present.
  name: string (required);
  num_inputs: int32;
  args: [ArgDesc];
}

enum ArchPortability : uint8 { Portable = 0, FamilyPortable = 1, ArchConditional = 2 }

struct SmTarget { compute_capability: int32; arch_portability: ArchPortability; }

table Cubin {
  bytes: [ubyte] (required);
}

table TileIRBytecode {
  bytes: [ubyte] (required);
  // Absent means the version is unknown (e.g. a bytecode file loaded from
  // disk outside the normal compile path). A reader can't safely assemble
  // this into a cubin without knowing the version.
  version: BcVersion;
}

union DeviceModule { Cubin, TileIRBytecode }

// Represents an encoding of host functions
// (e.g. elf).
table HostModule {
  abi_version: uint32;
  bytes: [ubyte] (required);
  triple: string (required);
}

table TensorIRArtifact {
  // Readers reject any version they don't exactly match; there is no
  // cross-version compatibility. Field additions alone don't need a version
  // bump, but any change to what an existing field means does.
  version: uint32;
  module_name: string (required);
  arch: SmTarget;

  // The device image/module. All referenced device entrypoints (`kernels`)
  // must be contained in this image.
  device_module: DeviceModule (required);

  // The list of device entrypoints. Each contains a function
  // name and other information about the kernel.
  // NOTE: The index within this list is the kernel ordinal.
  kernels: [KernelMetadata] (required);

  // Optional relocatable native host module.
  host_module: HostModule;

  // The list of invocable functions in this module. Each
  // corresponds to one 'nv_tensor_ir.graph' from the input
  // program.
  //
  // Currently each entrypoint launches one kernel, but this
  // will evolve in the future.
  entrypoints: [Entrypoint] (required);
}

root_type TensorIRArtifact;
file_identifier "TIR2";
