// RUN: not tensor_ir-tblgen %s --gen-component-options \
// RUN:   -I %S/../../../include %mlir_include_dirs 2>&1 \
// RUN:   | FileCheck %s

include "tensor_ir/Options/OptionsBase.td"

def FirstMode : I32Enum<"Mode", "First mode", [I32EnumCase<"A", 0>]> {
  let cppNamespace = "::mlir::nv_tensor_ir";
}
def SecondMode : I32Enum<"Mode", "Second mode", [I32EnumCase<"B", 0>]> {
  let cppNamespace = "::mlir::nv_tensor_ir";
}

def FrontendOptions : ComponentOptions<"Frontend"> {
  let invocationMember = "frontend";
  let options = [
    Option<"enabled", "frontend-enabled", "bool", "false", "Enable frontend">,
    EnumOption<"firstMode", "first-mode", FirstMode, "A", "First mode">,
    // CHECK: error: C API enum type 'MlirTensorIRFrontendMode' is generated from both 'FirstMode' and 'SecondMode'
    EnumOption<"secondMode", "second-mode", SecondMode, "B", "Second mode">
  ];
}
def BackendOptions : ComponentOptions<"Backend"> {
  let invocationMember = "backend";
  let options = [
    // CHECK: error: typed C API accessor 'Enabled' is generated by both 'frontend.enabled' and 'backend.enabled'
    Option<"enabled", "backend-enabled", "bool", "false", "Enable backend">
  ];
}

def CompilerInvocation
    : CompilerInvocationOptions<[FrontendOptions, BackendOptions]>;
